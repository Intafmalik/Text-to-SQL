# Gemini model to use (free tier supports these)
# GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL=gemini-3-flash-preview

# Temperature for SQL generation (lower = more deterministic)
TEMPERATURE=0.1

# --- Evaluation Settings ---
BENCHMARK_FILE=benchmark/questions.json
GROUND_TRUTH_FILE=benchmark/ground_truth_queries.sql
